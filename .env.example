# Copy to .env.local (git-ignored) and fill in.
# Used by the label-extraction vision call (src/lib/extract). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Model for label extraction. Default: claude-sonnet-5 (median ~3.9s per label).
# claude-opus-5 was more accurate in testing but ~5.8s median, over the 5-second budget.
# EXTRACTION_MODEL=claude-opus-5
